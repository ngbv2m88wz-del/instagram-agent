# Токен доступа Instagram Graph API (долгоживущий, ~60 дней)
INSTAGRAM_ACCESS_TOKEN=

# graph.instagram.com — вход через Instagram (ID аккаунта можно не указывать)
# graph.facebook.com  — вход через Facebook (нужен ID бизнес-аккаунта Instagram)
INSTAGRAM_API_HOST=graph.instagram.com
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_API_VERSION=v23.0

# Часовой пояс для анализа времени публикаций
INSTAGRAM_TIMEZONE=Europe/Moscow

ANTHROPIC_API_KEY=

# Цель аккаунта для рекомендаций Claude (необязательно)
INSTAGRAM_GOAL=

# Telegram-бот: токен от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чатов, которым разрешён доступ, через запятую (бот подскажет ID в ответ на любую команду)
TELEGRAM_ALLOWED_CHAT_IDS=
# Еженедельный отчёт: день и время в INSTAGRAM_TIMEZONE, например "mon 10:00"; пусто — выключено
TELEGRAM_REPORT_SCHEDULE=mon 10:00
# Сколько последних постов брать в отчёт
TELEGRAM_REPORT_POSTS=100
